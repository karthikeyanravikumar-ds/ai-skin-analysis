# ==============================================================================
# AI-Assisted Skin Image Analysis System - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and customize the values for your local environment.
# Never commit real API keys, credentials, or production secrets to version control.

# Google Gemini API Key (Optional: used for generative educational explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Authentication Configuration
AUTH_DB_PATH=reports/users.db
AUTH_SECRET_KEY=change_this_to_a_random_cryptographic_secret_in_production
SESSION_EXPIRY_HOURS=24
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# SMTP / Email Gateway Configuration (Required for future self-service password reset)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_EMAIL=security@skin-analysis.local
