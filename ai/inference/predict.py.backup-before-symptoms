    "impetigo": "Impetigo",
    "molluscum_contagiosum": "Molluscum Contagiosum",
    "psoriasis": "Psoriasis",
    "urticaria": "Urticaria",
    "vitiligo": "Vitiligo",
    "warts": "Warts"
}


