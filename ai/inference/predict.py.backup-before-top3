            'python "ai\\inference\\predict.py" '
            '"path\\to\\image.jpg" [--skip-gemini] [--symptoms "<json_string_or_path>"]'
        )

        forward_handle.remove()
        backward_handle.remove()

        sys.exit(1)


    raw_args = sys.argv[1:]
    image_path = None
    include_gemini = True
    symptoms_input = None

    idx = 0
    while idx < len(raw_args):
        arg = raw_args[idx]
        if arg == "--skip-gemini":
            include_gemini = False
            idx += 1
        elif arg in ("--symptoms", "--symptoms-json") and idx + 1 < len(raw_args):
            symptoms_val = raw_args[idx + 1]
            try:
                if os.path.exists(symptoms_val):
                    with open(symptoms_val, "r", encoding="utf-8") as sf:
                        symptoms_input = json.load(sf)
                else:
                    symptoms_input = json.loads(symptoms_val)
            except Exception as parse_err:
                print(f"[WARN] Could not parse symptoms argument: {parse_err}")
                symptoms_input = None
            idx += 2
        elif not arg.startswith("--") and image_path is None:
            image_path = arg
            idx += 1
        else:
            idx += 1

    if not image_path:
        print("\nERROR: No input image path provided.")
        forward_handle.remove()
        backward_handle.remove()
        sys.exit(1)


